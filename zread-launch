#!/usr/bin/env bash
set -euo pipefail

CFG="$HOME/.config/zread/config.json"
FONT_SIZE=10

if [ -f "$CFG" ]; then
  PARSED=$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(int(d.get("font_size", 10)))' "$CFG" 2>/dev/null || echo 10)
  FONT_SIZE="$PARSED"
fi

PROF_DIR="$HOME/.config/lxterminal"
mkdir -p "$PROF_DIR"
cat > "$PROF_DIR/zread.conf" <<EOF
[general]
fontname=Monospace ${FONT_SIZE}
hidemenubar=true
hidescrollbar=true
EOF

exec lxterminal --no-remote --profile=zread -e /usr/local/bin/zread "$@"
